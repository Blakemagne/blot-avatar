{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": {
      "@blot/avatar": ["./src/index.ts"],
      "@blot/jacrispy": ["./packages/jacrispy/src/index.ts"]
    }
  },
  "include": ["src", "packages/jacrispy/src"]
}
